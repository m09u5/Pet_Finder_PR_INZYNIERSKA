# --- PostgreSQL ---
# Local docker-compose default. Change host/credentials for other environments.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pet_finder?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pet_finder

# --- Backend (backend/.env) ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Resend) ---
# https://resend.com — free tier is enough for development/thesis purposes.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Pet Finder <onboarding@resend.dev>"

# --- Google Cloud Storage ---
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=pet-finder-images
# Path to a service account JSON key file with Storage Object Admin on the bucket.
GCS_KEY_FILE=./gcs-service-account.json

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
